<section class="bookmark-panel" aria-label="Add and manage bookmarks">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        aria-describedby="url-hint"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p id="url-hint" class="hint">Paste a URL with or without <code>https://</code>. We'll add it if needed.</p>
  <p id="feedback" class="feedback" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<script>
    import {
      formatBookmark,
      generateSlug,
      loadBookmarks,
      normalizeUrl,
      saveBookmarks,
      STORAGE_KEY,
    } from '../lib/bookmarks.js';

  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const feedback = document.getElementById('feedback');
  let bookmarks = [];
  let storage;

  function showFeedback(message) {
    feedback.textContent = message;
  }

  function renderBookmarks() {
    list.replaceChildren();

    for (const bookmark of bookmarks) {
      const row = document.createElement('li');
      row.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          showFeedback(`Copied ${bookmark.slug}.`);
        } catch {
          showFeedback('Could not copy the slug. Check your browser clipboard permissions.');
        }
      });

      const label = document.createElement('span');
      label.className = 'bookmark-label';
      label.append(link, separator, slug);

      row.append(label, copy);
      list.append(row);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  try {
    storage = window.localStorage;
    bookmarks = loadBookmarks(storage);
  } catch {
    showFeedback('Browser storage is unavailable. Bookmarks will only last for this page.');
  }
  renderBookmarks();

  form.addEventListener('submit', (event) => {
    event.preventDefault();

    try {
      const url = normalizeUrl(input.value);
      const slug = generateSlug(bookmarks.map((bookmark) => bookmark.slug));
      bookmarks.push({ url, slug });
      renderBookmarks();
      input.value = '';

      if (storage) {
        try {
          saveBookmarks(storage, bookmarks);
          showFeedback(`Saved ${formatBookmark({ url, slug })}.`);
        } catch {
          showFeedback('Bookmark added for this page, but browser storage could not save it.');
        }
      } else {
        showFeedback('Bookmark added for this page only; browser storage is unavailable.');
      }
    } catch (error) {
      showFeedback(error instanceof Error ? error.message : 'Could not add that bookmark.');
    }
  });

  document.getElementById('clear-all').addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) {
      return;
    }

    if (storage) {
      try {
        storage.removeItem(STORAGE_KEY);
      } catch {
        showFeedback('Could not clear bookmarks from browser storage.');
        return;
      }
    }

    bookmarks = [];
    renderBookmarks();
    showFeedback('All bookmarks cleared.');
  });
</script>

<style>
  .bookmark-panel {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, var(--accent) 4%, transparent);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 8%, transparent);
  }

  form {
    margin: 0;
  }

  .field {
    flex-basis: 18rem;
  }

  input {
    min-height: 2.8rem;
  }

  button {
    min-height: 2.8rem;
  }

  .hint {
    margin: 0.75rem 0 0.25rem;
  }

  .feedback {
    min-height: 1.4em;
    margin: 0.25rem 0 1rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .feedback:empty {
    display: none;
  }

  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.25rem 0 0.75rem;
  }

  .list-title {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-head);
  }

  #list-header[hidden] {
    display: none !important;
  }

  .clear,
  .copy {
    min-height: auto;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--border);
    background: transparent;
    color: inherit;
    font-size: 0.78rem;
    font-weight: 500;
  }

  .clear:hover,
  .copy:hover {
    border-color: currentColor;
  }

  ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bookmark {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    padding: 0.75rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 2%, transparent);
  }

  .bookmark-label {
    flex: 1 1 12rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .url {
    overflow-wrap: anywhere;
  }

  .separator {
    white-space: pre;
    color: var(--muted);
  }

  .slug {
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-family: var(--font-body);
    font-size: 0.85rem;
  }

  .empty {
    margin: 0.5rem 0 0;
    padding: 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  [hidden] {
    display: none !important;
  }
</style>
